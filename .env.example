# Cowrie pays from a SELF-CUSTODY wallet, not a Binance exchange sub-account.
# The MCP sub-account has no withdrawal scope and structurally cannot pay an external endpoint.

# EVM key — covers Base, BNB Chain, Polygon, Ethereum
COWRIE_EVM_PRIVATE_KEY=

# Solana key — optional, only needed to buy from Solana-settled services
COWRIE_SOLANA_PRIVATE_KEY=

# Hard ceiling across ALL rails, per day, in USD.
# Binance caps its own x402 payments at $20/day (vs $50k swaps, $100k DeFi).
COWRIE_DAILY_CEILING_USD=20

# Per-purchase cap in USD
COWRIE_MAX_PER_CALL_USD=0.50

# Where receipts are appended (JSONL)
COWRIE_LEDGER=receipts/ledger.jsonl
